<?xml version="1.0"?>
<robot name="xuegecar">
  <material name="dark_gray">
    <color rgba="0.08 0.08 0.08 1.0" />
  </material>
  <material name="matte_black">
    <color rgba="0.01 0.01 0.01 1.0" />
  </material>
  <material name="blue">
    <color rgba="0.05 0.18 0.8 1.0" />
  </material>
  <material name="silver">
    <color rgba="0.65 0.68 0.70 1.0" />
  </material>
  <link name="base_footprint" />
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.06205" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
    <collision>
      <origin xyz="0.0 0 0.005" rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.17 0.06" />
      </geometry>
    </collision>
  </link>
  <link name="chassis_link">
    <visual>
      <origin xyz="0.00225 0 -0.00925" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/chassis.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="drive_wheels_link">
    <visual>
      <origin xyz="0.053 0 0.020298" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/drive_wheels.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="matte_black" />
    </visual>
  </link>
  <joint name="drive_wheels_joint" type="fixed">
    <parent link="base_link" />
    <child link="drive_wheels_link" />
    <origin xyz="-0.05075 0 -0.029548" rpy="0 0 0" />
  </joint>
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="2.18300625e-05" ixy="0.0" ixz="0.0" iyy="1.2581697916666667e-05" iyz="0.0" izz="1.2581697916666667e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.02955" length="0.02" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="-0.05075 0.081 -0.02955" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="2.18300625e-05" ixy="0.0" ixz="0.0" iyy="1.2581697916666667e-05" iyz="0.0" izz="1.2581697916666667e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.02955" length="0.02" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="-0.05075 -0.081 -0.02955" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-05" />
    </inertial>
    <visual>
      <origin xyz="-0.06294 0.00001 0.0419" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/caster_wheel.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="matte_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0075" />
      </geometry>
    </collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster_link" />
    <origin xyz="0.06519 -0.00001 -0.05115" rpy="0 0 0" />
  </joint>
  <link name="battery_link">
    <visual>
      <origin xyz="0.027 0 -0.0145" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/battery.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dark_gray" />
    </visual>
  </link>
  <joint name="battery_joint" type="fixed">
    <parent link="base_link" />
    <child link="battery_link" />
    <origin xyz="-0.02475 0 0.00525" rpy="0 0 0" />
  </joint>
  <link name="controller_link">
    <visual>
      <origin xyz="0.027 0.000108 -0.027255" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/controller.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>
  <joint name="controller_joint" type="fixed">
    <parent link="base_link" />
    <child link="controller_link" />
    <origin xyz="-0.02475 -0.000108 0.018005" rpy="0 0 0" />
  </joint>
  <link name="tt_motor_link">
    <visual>
      <origin xyz="0.029154 0 0.0203" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/tt_motor.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dark_gray" />
    </visual>
  </link>
  <joint name="tt_motor_joint" type="fixed">
    <parent link="base_link" />
    <child link="tt_motor_link" />
    <origin xyz="-0.026904 0 -0.02955" rpy="0 0 0" />
  </joint>
  <link name="laser_frame">
    <visual>
      <origin xyz="0.02495 -0.000062 -0.07295" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/lidar.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="matte_black" />
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz="-0.0227 0.000062 0.0637" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="-0.045466 0.000603 -0.061658" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/camera.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="matte_black" />
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.047716 -0.000603 0.052408" rpy="0 0 0" />
  </joint>
  <link name="ultrasonic_link">
    <visual>
      <origin xyz="-0.040401 0 -0.0215" rpy="0 0 1.57079632679" />
      <geometry>
        <mesh filename="package://xuegecar_description/meshes/ultrasonic.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link" />
    <child link="ultrasonic_link" />
    <origin xyz="0.042651 0 0.01225" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.03" rpy="0 0 0" />
  </joint>
  <!-- ==================== 差速驱动 ==================== -->
  <!-- 发布 /odom、订阅 /cmd_vel。
       publish_odom_tf=false：odom->base_footprint 的 TF 交给 leap_ros_ws 自带的
       xuegecar_bringup 节点来发，与真机架构完全一致 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.162</wheel_separation>
      <wheel_diameter>0.0591</wheel_diameter>
      <max_wheel_torque>2.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ==================== 激光雷达 ==================== -->
  <!-- 与固件一致：360 点、0~359 度、1 度步进、0.02~12m、10Hz -->
  <!-- ⚠️ 关键：传感器挂到 base_link 上并显式写出安装偏移，而不是 reference="laser_frame"。
       原因：laser_frame 是 fixed joint，Gazebo 做固定关节合并时会丢掉这一层，
       导致传感器实际落在 base_link 原点 —— 表现为雷达一直在扫自己的车体
       （360 个点里只有 30 多个有限值，距离 0.10~0.15m，正好是底盘盒子的尺寸）。
       安装偏移来自 URDF: laser_joint = base_link + (-0.0227, 0.000062, 0.0637) -->
  <gazebo reference="base_link">
    <sensor type="ray" name="lidar">
      <pose>-0.0227 0.000062 0.0637 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.26573</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== IMU ==================== -->
  <!-- 同理：挂到 base_link，偏移取 URDF 的 imu_joint = (0, 0, 0.03) -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0.03 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== 物理与外观 ==================== -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="caster_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="laser_frame">
    <material>Gazebo/Red</material>
  </gazebo>
</robot>
